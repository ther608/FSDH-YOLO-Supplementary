# Citation metadata for the FSDH-YOLO supplementary materials repository.
#
# NOTE FOR THE AUTHORS: the fields marked "PLACEHOLDER" below must be filled in
# before this file is used. Author names are intentionally not guessed here.
# Once the manuscript is accepted, also add the DOI and the final article title.

cff-version: 1.2.0
message: "If you use these supplementary materials, please cite the manuscript below."
title: "FSDH-YOLO: Spatial-to-Depth Rearrangement and Hierarchical Feature Enhancement for Litchi Maturity Detection in Natural Orchards"
abstract: >-
  Supplementary materials for a lightweight litchi maturity detection model
  (FSDH-YOLO) built on a YOLO11n baseline. The repository provides per-seed
  results for every experiment reported in the paper, the evaluation protocol,
  and the complete Android on-device deployment package.
type: software
license: MIT
repository-code: "https://github.com/ther608/FSDH-YOLO-Supplementary"
url: "https://github.com/ther608/FSDH-YOLO-Supplementary"
keywords:
  - litchi maturity detection
  - object detection
  - YOLO11
  - small object detection
  - orchard computer vision
  - on-device inference
  - ONNX Runtime
  - Android deployment
authors:
  # PLACEHOLDER — replace with the real author list, in manuscript order.
  - family-names: "PLACEHOLDER"
    given-names: "PLACEHOLDER"

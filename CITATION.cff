# Citation metadata for the FSDH-YOLO supplementary materials repository.
#
# ANONYMITY: the authors are listed as "Anonymous Authors" because the associated
# manuscript is under review. Before the manuscript is published, replace the
# `authors` block below with the real author list in manuscript order, restore the
# article title in `preferred-citation`, and add the DOI.

cff-version: 1.2.0
message: "If you use these supplementary materials, please cite the associated paper."
title: "FSDH-YOLO Supplementary Materials"
abstract: >-
  Supplementary materials for a lightweight litchi maturity detection model
  (FSDH-YOLO) built on a YOLO11n baseline. The repository provides per-seed
  results for every experiment reported in the paper, the evaluation protocol,
  and the complete Android on-device deployment package. Datasets and trained
  checkpoints are not redistributed.
type: software
license: MIT
repository-code: "https://github.com/ther608/FSDH-YOLO-Supplementary"
url: "https://github.com/ther608/FSDH-YOLO-Supplementary"
keywords:
  - litchi maturity detection
  - object detection
  - YOLO11
  - small object detection
  - orchard computer vision
  - on-device inference
  - ONNX Runtime
  - Android deployment
authors:
  - family-names: "Anonymous"
    given-names: "Authors"
version: "1.0.0"
date-released: "2026-10-11"


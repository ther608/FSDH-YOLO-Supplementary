<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <!-- Monospace so the summary columns line up. The lines are kept under
         ~62 characters in BenchActivity, which is what fits at 11sp on a
         1080p phone; longer ones wrap, which is untidy but never overlaps. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:scrollbars="vertical"
        android:textColor="@color/fg"
        android:textSize="11sp"
        android:text="@string/bench_ready" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Three buttons across one row: autosize keeps "1. Capture" from
             being clipped the way a fixed 14sp would be on a narrow screen. -->
        <Button
            android:id="@+id/btnCapture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/btn_capture" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:enabled="false"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/btn_run" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:enabled="false"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/btn_share" />
    </LinearLayout>

</LinearLayout>
